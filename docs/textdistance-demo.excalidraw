      "text": "2. Thin Python adapter\n\ntextdistance/_rust_adapter.py\n\n• validates supported inputs\n• converts Python ↔ Rust values\n• dispatches the algorithm\n• converts the result back\n• no Python fallback",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Thin Python adapter\n\ntextdistance/_rust_adapter.py\n\n• validates supported inputs\n• converts Python ↔ Rust values\n• dispatches the algorithm\n• converts the result back\n• no Python fallback",
      "autoResize": true,
